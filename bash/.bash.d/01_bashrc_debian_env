# ~/.bash.d/01_bashrc_debian_env

# Only apply on Debian systems
if [ ! -f /etc/debian_version ]; then
    return
fi

# gitme search roots (Debian/Pi): home directory
export GITME_DIRS="$HOME"
# CHECK_GIT_REPOS and CHECK_GIT_BRANCH deliberately unset: both tools always
# scan $HOME and treat these variables as additive extra roots (check-git-branch
# since v2.0.0), so setting them to $HOME only walked the tree twice. There is
# nothing beyond $HOME to scan on Raspberry Pi OS.

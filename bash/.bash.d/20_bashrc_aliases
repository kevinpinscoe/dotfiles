unalias reload 2>/dev/null
function reload {
    # exec a fresh login shell instead of re-sourcing the rc.
    # Re-sourcing ~/.zshrc in the same process corrupts ZLE widget
    # wrappers (zsh-sage, zsh-autosuggestions, etc.), causing
    # "_sage_suggest_widget:5: maximum nested function level reached".
    if [ -n "${ZSH_VERSION:-}" ]; then
        exec zsh -l
    else
        exec bash -l
    fi
}

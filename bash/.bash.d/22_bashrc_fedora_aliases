# ~/.bash.d/22_bashrc_fedora_aliases

# Only apply on Fedora systems
if [ ! -f /etc/fedora-release ]; then
    return
fi

# cd into the personal journal vault (Fedora only; macOS uses ~/Journal/Professional)
alias j='cd ~/Journal/personal-journal/personal-journal'

# Launch Obsidian Personal Journal vault
alias journal='~/AppImages/Obsidian.AppImage "obsidian://open?vault=Personal%20Journal" &>/dev/null &'

# Log in to self-hosted Gitea container registry. Token brokered by parzival --
# bao:app/gitea deliberately excludes parzival's `get` mode everywhere in
# ~/.config/parzival/policy.json, so the token is never held as a bash variable
# here; it is rendered to $PARZIVAL_CRED_FILE for the lifetime of this one
# `docker login` call and read from there, the same gitea-token exec profile
# ~/admin/sentinel/lib/check-gitea.sh uses. KSA-20 (PARZIVAL-2 fallout):
# replaces the old `cat ~/.environment/.vault-token` read -- that file was
# permanently removed 2026-09-05.
dlogin() {
    parzival exec --as tea gitea-token -- \
        sh -c 'docker login git.kevininscoe.com --username kevin --password-stdin < "$PARZIVAL_CRED_FILE"'
}

# Jump to the knowledge vault. The directory name differs per Fedora host: the
# FLDW has ~/KnowledgeVault, while the mac-container / realm-test container's ~
# is symlinks into the Mac's home, whose vault is ~/WorkKnowledgeVault.
# 21_bashrc_mac_aliases already points `km` there, but that file is macOS-gated
# and never runs inside the container, so `km` fell through to this Fedora
# definition and failed with
# "cd: no such file or directory: /home/kevini/KnowledgeVault".
# Gate on the directory rather than the hostname, as 01_bashrc_fedora_env does.
if [ -d "$HOME/KnowledgeVault" ]; then
    alias km='cd $HOME/KnowledgeVault'
else
    alias km='cd $HOME/WorkKnowledgeVault'
fi

# cd into the Obsidian PKM vault inside KnowledgeVault and label the tab.
# A function, not a plain alias -- see the `pcm` function in 20_bashrc_aliases
# and its RUNBOOK.md writeup for why (a spawned process can't cd its parent
# shell, only a function running in the shell itself can).
unalias pkm 2>/dev/null
pkm() {
    cd "$HOME/KnowledgeVault/PKM" && set-ghostty-tab-name PKM
}

# SSH into the acst account on this machine
alias work='ssh acst@127.0.0.1'

# Open the prescription pickup log in LibreOffice Calc.
# FLDW only: this file is Fedora-gated, but `john` is Fedora too and has no
# clone of ~/sheets/spreadsheet-files, so the alias is gated on the hostname
# rather than the distribution. See https://youtrack.kevininscoe.com/issue/APP-5
# setsid detaches Calc from the terminal; the subshell keeps job-control noise
# out of the prompt in both bash and zsh.
if [[ "$(hostname)" == "kevin" ]]; then
    alias pi='(setsid soffice --calc "$HOME/sheets/spreadsheet-files/medical/prescription-inventory.fods" >/dev/null 2>&1 &)'
fi

{
  // Disable nagging
  "extensions.ignoreRecommendations": true,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": "off",
  "update.mode": "none",

  // Poor practice but is causing me grief
  "security.workspace.trust.enabled": false,
  
  // Files auto save
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 100,

  // Editor
  "editor.fontSize": 16,
  "editor.inlineSuggest.suppressSuggestions": true,
  "editor.accessibilitySupport": "off",
  "editor.multiCursorModifier": "alt",

  // Restore previous session (avoid reopening a bunch of windows)
  "window.restoreWindows": "preserve",
  "files.hotExit": "onExitAndWindowClose",
  "workbench.editor.restoreViewState": true,
  // Prevents the welcome page from opening instead of your restored tabs.
  "workbench.startupEditor": "none",
  "window.openFilesInNewWindow": "off",

  // Explorer
  "explorer.confirmDelete": false,

  // Redhat
  "redhat.telemetry.enabled": false,

  // Shell env
  "application.shellEnvironmentResolutionTimeout": 30,

  // Go
  "go.toolsManagement.autoUpdate": true,
  "go.diagnostic.vulncheck": "Imports",

  // MSSQL
  "mssql.connectionGroups": [
    {
      "name": "ROOT",
      "id": "ED9F143E-6F3E-46E8-96DD-547681FB05B0",
    },
  ],
  "mssql.connections": [],

  // Spelling
  "cSpell.fixSpellingWithRenameProvider": false,
  "cSpell.userWords": [
    "heavenlies",
    "journaling",
    "mindmap",
    "mindmaps",
    "multistep"
  ],
  "cSpell.ignorePaths": [
      "**/.vscode/settings.json",
      "**/.vscode/*.code-workspace"
    ],
    "cSpell.enabledLanguageTypes": [
      "markdown",
      "plaintext",
      "yaml",
      "terraform",
      "go",
      "python"
    ],

  // Docker Compose
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },

  // GitHub Actions
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },

  // Wrapping / Rulers
  "editor.rulers": [70],
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 70,
  "[plaintext]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 70,
  },
  "[markdown]": {
    "editor.wordWrap": "wordWrapColumn",
    "editor.wordWrapColumn": 70,
  },

  // Theme / misc
  "workbench.colorTheme": "Dank Neon",
  "aws.cloudformation.telemetry.enabled": false,
  "makefile.configureOnOpen": true,

  // File associations
  "files.associations": {
    "*.mmd": "markdown",
  },
  "claudeCode.preferredLocation": "panel",

  // ---------------------------------------------------------------------
  // File watching / search scope  (APP-1)
  //
  // The extension host was OOM-crashing hourly: the workspace watched all of
  // $HOME, giving one watcher process 490k inotify watches and a 2 GB RSS.
  // The event flood filled the extension host's V8 heap until it aborted
  // (SIGTRAP / exit 133). These excludes keep the watcher off trees that
  // churn constantly and are never edited by hand.
  // ---------------------------------------------------------------------
  "files.watcherExclude": {
    // VS Code defaults, restated so they survive this override
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.hg/store/**": true,

    // Caches and per-user state: ~204k directories, none hand-edited
    "**/.cache/**": true,
    "**/.local/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true,

    // VS Code's own output — watching it feeds its own events back in
    "**/.config/Code/**": true,
    "**/.vscode/extensions/**": true,

    // Never explored per ~/CLAUDE.md, and 22 repos deep
    "**/3rd-party-repos/**": true,

    // Build output
    "**/dist/**": true,
    "**/build/**": true,
    "**/target/**": true,
    "**/.terraform/**": true
  },

  "search.exclude": {
    "**/node_modules": true,
    "**/.cache": true,
    "**/.local": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.config/Code": true,
    "**/3rd-party-repos": true,
    "**/dist": true,
    "**/build": true,
    "**/.terraform": true
  },

  // ---------------------------------------------------------------------
  // Git repository discovery  (APP-1)
  //
  // Auto-detection opened 42 repos but logged 183 open events — repeated
  // teardown/reopen churn — and 375 `git status -z -uall` calls in one
  // session. "openEditors" attaches Git only to repos you actually have a
  // file open in. Set back to true if you want the old scan-everything
  // behaviour.
  // ---------------------------------------------------------------------
  "git.autoRepositoryDetection": "openEditors",
  "git.repositoryScanMaxDepth": 2,
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    ".cache",
    ".local",
    "3rd-party-repos"
  ],
}

### Typical workflow
# Set env vars (add to ~/.bashrc or ~/.bash.d/ fragment)
export BAO_ADDR=https://openbao.kevininscoe.com
export BAO_TOKEN=$(cat ~/.vault-token)

# Check status
bao status

# KV v2 — read/write
bao kv put -mount=k3s tailscale/operator key=<value>
bao kv get -mount=k3s tailscale/operator
bao kv list -mount=k3s

# List mounts / policies
bao secrets list
bao policy list
bao policy read <name>

# AppRole auth
bao auth enable approle
bao write auth/approle/role/<role> token_policies=<policy>
bao read auth/approle/role/<role>/role-id
bao write -f auth/approle/role/<role>/secret-id

if command -v kubectl >/dev/null 2>&1; then
    source <(kubectl completion zsh)
    compdef _kubectl k
fi

# gitme — the shared script in ~/Projects/public/gitme works in zsh as well as
# bash since gitme 0.0.6 (KTA-80), so it is sourced here instead of keeping a
# zsh-only copy. A missing clone is skipped silently so shell startup never breaks.
if [[ -r "$HOME/Projects/public/gitme/gitme" ]]; then
    source "$HOME/Projects/public/gitme/gitme"
fi

if [[ -f "$HOME/Projects/public/gitme/gitme-completion.bash" ]]; then
    autoload -U +X bashcompinit && bashcompinit
    source "$HOME/Projects/public/gitme/gitme-completion.bash"
fi

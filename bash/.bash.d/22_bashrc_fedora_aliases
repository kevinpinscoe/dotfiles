# ~/.bash.d/22_bashrc_fedora_aliases

# Only apply on Fedora systems
if [ ! -f /etc/fedora-release ]; then
    return
fi

# cd into the personal journal vault (Fedora only; macOS uses ~/Journal/Professional)
alias j='cd ~/Journal/personal-journal'

# Launch Obsidian Personal Journal vault
alias journal='~/AppImages/Obsidian.AppImage "obsidian://open?vault=Personal%20Journal" &>/dev/null &'

# Log in to self-hosted Gitea container registry (token brokered from OpenBao, no on-disk file)
alias dlogin='BAO_ADDR=https://openbao.kevininscoe.com BAO_TOKEN="$(cat ~/.environment/.vault-token)" bao kv get -field=token -mount=app gitea | docker login git.kevininscoe.com --username kevin --password-stdin'

alias km='cd $HOME/KnowledgeVault'

# cd into the Obsidian PKM vault inside KnowledgeVault
alias pkm='cd $HOME/KnowledgeVault/PKM'

# SSH into the acst account on this machine
alias work='ssh acst@127.0.0.1'

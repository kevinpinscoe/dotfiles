# Tooling directories added earlier (00_bashrc_env, 01_*_env) must always win over the
# standard OS command directories below on a name collision -- e.g. the `rg`/`ugrep` shims in
# ~/tools superseding /usr/bin/rg and /usr/bin/ugrep. Prepending private-tools here is not enough on its
# own: the six standard dirs below are usually *already* in the inherited login PATH
# (from a login manager, /etc/profile, etc.), so a plain "add if missing" is a no-op that
# leaves them wherever the environment happened to put them -- sometimes ahead of a
# custom tooling directory. Force them to the true end of PATH instead.

# private-tools is moved to the front even when already present: an inherited PATH (e.g. a
# JetBrains IDE terminal) can carry it behind ~/bin, and "add if missing" would leave it there.
_pathtofront() {
  local dir="$1"
  local wrapped=":$PATH:"
  wrapped="${wrapped//:$dir:/:}"
  wrapped="${wrapped#:}"
  wrapped="${wrapped%:}"
  export PATH="$dir:$wrapped"
}
_pathtofront "$HOME/private-tools"
unset -f _pathtofront

_pathtoend() {
  local dir="$1"
  [ -d "$dir" ] || return 0
  local wrapped=":$PATH:"
  wrapped="${wrapped//:$dir:/:}"
  wrapped="${wrapped#:}"
  wrapped="${wrapped%:}"
  export PATH="$wrapped:$dir"
}
_pathtoend /usr/local/sbin
_pathtoend /usr/local/bin
_pathtoend /usr/sbin
_pathtoend /usr/bin
_pathtoend /sbin
_pathtoend /bin
unset -f _pathtoend

# ~/.bash.d/01_bashrc_fedora_env

# Only apply on Fedora systems
if [ ! -f /etc/fedora-release ]; then
    return
fi

# gitme search roots (Fedora): home directory plus containers repo
export GITME_DIRS="$HOME:/opt/containers"
# Both tools always scan $HOME and treat these variables as additive (
# check-git-branch since v2.0.0), so they list extra roots only. Scanned here:
# $HOME + /opt/containers.
export CHECK_GIT_REPOS="/opt/containers"
export CHECK_GIT_BRANCH="/opt/containers"

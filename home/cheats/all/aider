## Command options

aider [OPTIONS] [FILE ...]

  --model MODEL           Model to use for the main chat (env: AIDER_MODEL)
  --sonnet                Use the Anthropic Claude Sonnet model
  --opus                  Use the Anthropic Claude Opus model
  --deepseek              Use the DeepSeek model
  --api-key PROVIDER=KEY  Set an API key, e.g. anthropic=sk-...
  --architect             Use architect edit format for the main chat
  --file FILE             Add a file to the chat (repeatable)
  --read FILE             Add a read-only file for context (repeatable)
  -m, --message COMMAND   Run a single message/command then exit
  -f, --message-file FILE Read the message to send from a file
  --yes-always            Auto-confirm every prompt (non-interactive)
  --commit                Commit all pending changes with an AI commit message
  --auto-commits, --no-auto-commits   Toggle auto-commit of aider's edits
  --vim                   Use vi editing mode in the terminal
  --dark-mode             Colors for a dark terminal background
  --light-mode            Colors for a light terminal background
  --version               Show the version number and exit
  --help                  Show the full help and exit

  # Common usage
  aider                            # start in the current git repo
  aider file1.py file2.py          # start with specific files in the chat
  aider --model sonnet             # pick a model
  aider --sonnet main.go           # edit main.go with Claude Sonnet
